# Porgrama que dada uma matriz de elementos aleatórios
# podemos manipular suas linhas e colunas
#rotacionando a matriz no sentido horário,
#transpões pela diagonal principal e secundária
#E reflete horizontalmente e verticalmente
#################################################

def rodamatriz(a):
    """
    Rotaciona a matriz no sentido horário.
    :param a: Matriz inicial
    :return: Matriz rotacionada
    """
    c = []#Contruindoa matriz auxiliar
    b = [0]*4#Contruindoa matriz auxiliar
    for i in range(4):#Contruindoa matriz auxiliar
        c.append(b[:])#Contruindoa matriz auxiliar
    a.reverse()#inverte a matriz "a" verticalmete,

    for k in range(len(c)):
        for j in range(len(c)):
            c[k][j] = a[j][k] #"copia" pra matriz auxiliar os elemtos da matriz a
                              # de maneira a pegar os elementos que estão nas colunas de "a"
                              # e colar nas linha de "c".
    return c

def transp1 (a):
    """
    Transpoem a matriz em relação a diagonal principal
    :param a: Matriz inicial
    :return: Matriz transposta
    """
    c = []#Contruindoa matriz auxiliar
    b = [0] * 4#Contruindoa matriz auxiliar
    for i in range(4):#Contruindoa matriz auxiliar
        c.append(b[:])#Contruindoa matriz auxiliar

    for k in range(len(c)):
        for j in range(len(c)):

            c[k][j] = a[j][k]#"copia" pra matriz auxiliar os elemtos da matriz a
                              # de maneira a pegar os elementos que estão nas colunas de "a"
                              # e colar nas linha de "c".
    return c

def invV(a):
    """
    Inverte a matriz na vertical
    :param a: Matriz inicial
    :return: Matriz invertida
    """
    a.reverse() #inverte a matriz verticalmente
    return a

def invH (a):
    """
    Inverte a matriz horizontalmente.
    :param a: Matriz inicial
    :return: Matriz invertida
    """
    c =  rodamatriz(a)#roda a matriz uma vez pra direita
    c = rodamatriz(c)#roda a matriz pela segunda vez pra direita
    c.reverse()# inverte a matriz verticalmente
    return c

def transp2 (a):
    """
    Transpoem a matriz a em relação a diagonal secundaria.
    :param a: Matriz inicial
    :return: matriz transposta
    """

    a =  invH(a) #Inverte a matriz horizontalmente (a diagonal secundária se torna a principal)
    a = transp1(a) #Transpõem a matriz pela diagonal principal(transpor a matriz não altera a sua diagonal)
    a =  invH(a) # Inverte horizontalmente a matriz novamente para voltar a diagonal principal pra secundária
    return a

