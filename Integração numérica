def prod_esc(X,Y,P):
    e = 0 # Inicializa a variável 'e' para acumular o produto escalar ponderado
    for i in range(len(X)): # Itera sobre os elementos das listas X, Y e P
        e = e + P[i]*X[i]*Y[i] # Calcula o produto de P[i]*X[i]*Y[i] e acumula em 'e'
    return e # Retorna o produto escalar ponderado (essa função não é usada no fluxo principal de integração aqui)

def S_n (I_0, I_f, N):
    L_n = [] # Lista para armazenar os pontos dos intervalos para cada N
    F = [] # Lista para armazenar os valores da função para cada conjunto de pontos
    S = [] # Lista para armazenar os resultados da regra de Simpson para cada N
    for i in range(len(N)): # Itera sobre diferentes números de subintervalos 'N'
        # Gera a lista de pontos para o número de subintervalos N[i]
        L_n.append(list_interv(I_0, I_f, N[i]))
        # Calcula os valores da função 'f' para os pontos gerados
        F.append(calcu_func(L_n[i]))
        # Calcula a integral usando a regra de Simpson para os valores da função e N[i]
        S.append(simpson(F[i], I_0, I_f, N[i]))
    print("\n L_n = ", L_n, "\n F_n = ", F) # Imprime as listas de pontos e valores da função (debug)

    return S # Retorna a lista de integrais calculadas por Simpson

